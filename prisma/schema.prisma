// SIIB — Sistema Integral de Inventario de Bomberos
// Schema completo. Cambios respecto a la propuesta original:
//  - transfers + transfer_items separados de inventory_movements (workflow distinto).
//  - role/unitType/materialType/status como enums (especificación cerrada).
//  - consumable_inventory permite múltiples lotes por (material, unidad, batch_number).
//  - Tablas Auth.js (Account, Session, VerificationToken) para sesiones en BD.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums

enum UserRole {
  COMANDANCIA_ADMIN
  UNIT_MANAGER
  OPERATIONAL
}

enum UnitType {
  CUARTEL
  CAMPO_ENTRENAMIENTO
  BODEGA
  COMANDANCIA
}

enum MaterialType {
  MATERIAL_MAYOR
  MATERIAL_MENOR
  EPP
  EQUIPO_OPERATIVO
  INSUMO
}

enum AssetStatus {
  OPERATIVO
  DISPONIBLE
  OBSERVADO
  EN_MANTENCION
  FUERA_DE_SERVICIO
  RESERVADO
  DADO_DE_BAJA
}

enum ConsumableStatus {
  DISPONIBLE
  BAJO_STOCK
  VENCIDO
  PROXIMO_VENCER
  RESERVADO
  AGOTADO
}

enum MovementType {
  INGRESO
  SALIDA
  CONSUMO
  TRASLADO
  BAJA
  ENVIO_MANTENCION
  RETORNO_MANTENCION
  RESERVA
  AJUSTE
  ASIGNACION_VEHICULO
  ASIGNACION_BOMBERO
}

enum MovementStatus {
  REGISTRADO
  PENDIENTE
  CONFIRMADO
  ANULADO
}

enum TransferStatus {
  SOLICITADO
  APROBADO
  PREPARADO
  EN_TRANSITO
  RECIBIDO
  RECHAZADO
  CANCELADO
}

enum MaintenanceType {
  PREVENTIVA
  CORRECTIVA
  CERTIFICACION
  CALIBRACION
  PRUEBA_HIDRAULICA
  INSPECCION
  RECARGA
  REPARACION
  LIMPIEZA_TECNICA
  CAMBIO_PIEZAS
}

enum DocumentType {
  ORDEN_MANTENCION
  CERTIFICADO
  FACTURA
  INFORME_TECNICO
  ACTA_ENTREGA
  ACTA_BAJA
  MANUAL
  GUIA_DESPACHO
  OTRO
}

enum AlertType {
  STOCK_BAJO
  STOCK_AGOTADO
  INSUMO_VENCIDO
  INSUMO_PROXIMO_VENCER
  ACTIVO_FUERA_SERVICIO
  ACTIVO_EN_MANTENCION
  MANTENCION_VENCIDA
  MANTENCION_PROXIMA
  CERTIFICACION_VENCIDA
  EPP_VENCIDO
  PRUEBA_HIDRAULICA_VENCIDA
  ACTIVO_SIN_HOJA_VIDA
  DOCUMENTO_PENDIENTE
}

enum AlertStatus {
  ABIERTA
  DESCARTADA
  RESUELTA
}

// ───────────────────────── Modelos

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  unitId       String?  @map("unit_id")
  unit         Unit?    @relation("UnitMembers", fields: [unitId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  responsibleOf       Unit[]              @relation("UnitResponsible")
  maintenancesReg     MaintenanceRecord[]
  documentsUploaded   Document[]
  movements           InventoryMovement[]
  transfersRequested  Transfer[]          @relation("TransferRequested")
  transfersApproved   Transfer[]          @relation("TransferApproved")
  transfersReceived   Transfer[]          @relation("TransferReceived")
  auditLogs           AuditLog[]
  sessions            Session[]
  accounts            Account[]
  materialsAssigned   MaterialSerialNumber[] @relation("MaterialAssignedToUser")

  @@index([role])
  @@index([unitId])
  @@map("users")
}

// ── Auth.js tables ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── Dominio ─────────────────────────────────────────────────────

model Unit {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  unitType          UnitType @map("unit_type")
  address           String?
  city              String?
  responsibleUserId String?  @map("responsible_user_id")
  responsibleUser   User?    @relation("UnitResponsible", fields: [responsibleUserId], references: [id])
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  members         User[]                @relation("UnitMembers")
  assets          Asset[]
  consumables     ConsumableInventory[]
  movementsOrigin InventoryMovement[]   @relation("MovementOrigin")
  movementsDest   InventoryMovement[]   @relation("MovementDest")
  transfersOrigin Transfer[]            @relation("TransferOrigin")
  transfersDest   Transfer[]            @relation("TransferDest")
  alerts          Alert[]
  materialsAssigned MaterialSerialNumber[] @relation("MaterialAssignedToUnit")
  materialStocks  UnitMaterialStock[]

  @@index([unitType, active])
  @@map("units")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  materials Material[]

  @@map("categories")
}

model Material {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  brand        String
  model        String?
  partNumber   String?      @map("part_number")
  categoryId   String       @map("category_id")
  category     Category     @relation(fields: [categoryId], references: [id])
  materialType MaterialType @map("material_type")
  description  String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  assets         Asset[]
  consumables    ConsumableInventory[]
  movements      InventoryMovement[]
  transferItems  TransferItem[]
  images         MaterialImage[]
  serialNumbers  MaterialSerialNumber[]
  unitStocks     UnitMaterialStock[]

  @@index([materialType, active])
  @@map("materials")
}

model MaterialImage {
  id        String   @id @default(cuid())
  materialId String  @map("material_id")
  material  Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  fileUrl   String   @map("file_url")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([materialId, order], name: "material_order_unique")
  @@map("material_images")
}

model MaterialSerialNumber {
  id           String   @id @default(cuid())
  materialId   String   @map("material_id")
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  serialNumber String   @unique @map("serial_number")
  assignedToUserId String? @map("assigned_to_user_id")
  assignedToUser User?   @relation("MaterialAssignedToUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedToUnitId String? @map("assigned_to_unit_id")
  assignedToUnit Unit?   @relation("MaterialAssignedToUnit", fields: [assignedToUnitId], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([materialId])
  @@index([assignedToUserId])
  @@index([assignedToUnitId])
  @@map("material_serial_numbers")
}

model UnitMaterialStock {
  id         String   @id @default(cuid())
  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  unitId     String   @map("unit_id")
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  quantity   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([materialId, unitId], name: "material_unit_unique")
  @@index([unitId])
  @@index([quantity])
  @@map("unit_material_stocks")
}

model Asset {
  id               String      @id @default(cuid())
  materialId       String      @map("material_id")
  material         Material    @relation(fields: [materialId], references: [id])
  unitId           String      @map("unit_id")
  unit             Unit        @relation(fields: [unitId], references: [id])
  internalCode     String      @unique @map("internal_code")
  // Postgres trata múltiples NULL como distintos, así que @unique vale para "único cuando no es null".
  serialNumber     String?     @unique @map("serial_number")
  brand            String?
  model            String?
  licensePlate     String?     @map("license_plate")
  year             Int?
  specificLocation String?     @map("specific_location")
  responsibleName  String?     @map("responsible_name")
  entryDate        DateTime    @map("entry_date")
  expirationDate   DateTime?   @map("expiration_date")
  status           AssetStatus @default(OPERATIVO)
  observations     String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  maintenances  MaintenanceRecord[]
  documents     Document[]
  movements     InventoryMovement[]
  transferItems TransferItem[]
  alerts        Alert[]

  @@index([unitId, status])
  @@index([materialId])
  @@map("assets")
}

model ConsumableInventory {
  id             String           @id @default(cuid())
  materialId     String           @map("material_id")
  material       Material         @relation(fields: [materialId], references: [id])
  unitId         String           @map("unit_id")
  unit           Unit             @relation(fields: [unitId], references: [id])
  currentStock   Decimal          @default(0) @map("current_stock") @db.Decimal(12, 2)
  minimumStock   Decimal          @default(0) @map("minimum_stock") @db.Decimal(12, 2)
  unitOfMeasure  String           @map("unit_of_measure")
  batchNumber    String?          @map("batch_number")
  expirationDate DateTime?        @map("expiration_date")
  entryDate      DateTime         @map("entry_date")
  location       String?
  status         ConsumableStatus @default(DISPONIBLE)
  observations   String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  alerts Alert[]

  @@unique([materialId, unitId, batchNumber])
  @@index([unitId, status])
  @@map("consumable_inventory")
}

model MaintenanceRecord {
  id                  String          @id @default(cuid())
  assetId             String          @map("asset_id")
  asset               Asset           @relation(fields: [assetId], references: [id])
  maintenanceDate     DateTime        @map("maintenance_date")
  maintenanceType     MaintenanceType @map("maintenance_type")
  description         String
  responsiblePerson   String?         @map("responsible_person")
  externalCompany     String?         @map("external_company")
  workOrderNumber     String?         @map("work_order_number")
  cost                Decimal?        @db.Decimal(12, 2)
  resultingStatus     AssetStatus     @map("resulting_status")
  nextMaintenanceDate DateTime?       @map("next_maintenance_date")
  registeredByUserId  String          @map("registered_by_user_id")
  registeredBy        User            @relation(fields: [registeredByUserId], references: [id])
  cancelled           Boolean         @default(false)
  cancelReason        String?         @map("cancel_reason")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  documents Document[]

  @@index([assetId, maintenanceDate])
  @@index([nextMaintenanceDate])
  @@map("maintenance_records")
}

model Document {
  id                  String             @id @default(cuid())
  assetId             String?            @map("asset_id")
  asset               Asset?             @relation(fields: [assetId], references: [id])
  maintenanceRecordId String?            @map("maintenance_record_id")
  maintenanceRecord   MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id])
  documentType        DocumentType       @map("document_type")
  fileName            String             @map("file_name")
  filePath            String             @map("file_path")
  fileSize            Int                @map("file_size")
  uploadedByUserId    String             @map("uploaded_by_user_id")
  uploadedBy          User               @relation(fields: [uploadedByUserId], references: [id])
  uploadDate          DateTime           @default(now()) @map("upload_date")
  observations        String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  movements InventoryMovement[]

  @@map("documents")
}

model InventoryMovement {
  id                String         @id @default(cuid())
  materialId        String         @map("material_id")
  material          Material       @relation(fields: [materialId], references: [id])
  assetId           String?        @map("asset_id")
  asset             Asset?         @relation(fields: [assetId], references: [id])
  originUnitId      String?        @map("origin_unit_id")
  originUnit        Unit?          @relation("MovementOrigin", fields: [originUnitId], references: [id])
  destinationUnitId String?        @map("destination_unit_id")
  destinationUnit   Unit?          @relation("MovementDest", fields: [destinationUnitId], references: [id])
  movementType      MovementType   @map("movement_type")
  quantity          Decimal        @db.Decimal(12, 2)
  movementDate      DateTime       @default(now()) @map("movement_date")
  userId            String         @map("user_id")
  user              User           @relation(fields: [userId], references: [id])
  authorizedBy      String?        @map("authorized_by")
  reason            String?
  movementStatus    MovementStatus @default(REGISTRADO) @map("movement_status")
  documentId        String?        @map("document_id")
  document          Document?      @relation(fields: [documentId], references: [id])
  transferId        String?        @map("transfer_id")
  transfer          Transfer?      @relation(fields: [transferId], references: [id])
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([assetId, movementDate(sort: Desc)])
  @@index([materialId, originUnitId, movementDate(sort: Desc)])
  @@index([destinationUnitId, movementDate(sort: Desc)])
  @@map("inventory_movements")
}

model Transfer {
  id                String         @id @default(cuid())
  code              String         @unique
  originUnitId      String         @map("origin_unit_id")
  originUnit        Unit           @relation("TransferOrigin", fields: [originUnitId], references: [id])
  destinationUnitId String         @map("destination_unit_id")
  destinationUnit   Unit           @relation("TransferDest", fields: [destinationUnitId], references: [id])
  status            TransferStatus @default(SOLICITADO)
  reason            String?
  requestedById     String         @map("requested_by")
  requestedBy       User           @relation("TransferRequested", fields: [requestedById], references: [id])
  approvedById      String?        @map("approved_by")
  approvedBy        User?          @relation("TransferApproved", fields: [approvedById], references: [id])
  approvedAt        DateTime?      @map("approved_at")
  receivedById      String?        @map("received_by")
  receivedBy        User?          @relation("TransferReceived", fields: [receivedById], references: [id])
  receivedAt        DateTime?      @map("received_at")
  rejectionReason   String?        @map("rejection_reason")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  items     TransferItem[]
  movements InventoryMovement[]

  @@index([status])
  @@index([destinationUnitId, status])
  @@map("transfers")
}

model TransferItem {
  id         String    @id @default(cuid())
  transferId String    @map("transfer_id")
  transfer   Transfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  assetId    String?   @map("asset_id")
  asset      Asset?    @relation(fields: [assetId], references: [id])
  materialId String?   @map("material_id")
  material   Material? @relation(fields: [materialId], references: [id])
  quantity   Decimal   @db.Decimal(12, 2)
  notes      String?

  @@map("transfer_items")
}

model Alert {
  id           String               @id @default(cuid())
  unitId       String               @map("unit_id")
  unit         Unit                 @relation(fields: [unitId], references: [id])
  assetId      String?              @map("asset_id")
  asset        Asset?               @relation(fields: [assetId], references: [id])
  consumableId String?              @map("consumable_id")
  consumable   ConsumableInventory? @relation(fields: [consumableId], references: [id])
  alertType    AlertType            @map("alert_type")
  title        String
  description  String?
  status       AlertStatus          @default(ABIERTA)
  dueDate      DateTime?            @map("due_date")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([unitId, status])
  @@index([alertType, status])
  @@map("alerts")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([tableName, recordId])
  @@map("audit_logs")
}
