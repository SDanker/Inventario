# ─────────────────────────────────────────────────────────────────
# SIIB — Sistema Integral de Inventario de Bomberos
# Copia este archivo como .env y completa los valores.
# ─────────────────────────────────────────────────────────────────
# Este archivo sirve para LAS DOS modalidades:
#  • Modo Docker     → ver INSTALL-DOCKER.md
#  • Modo nativo     → ver INSTALL-NATIVE.md
# Los comentarios marcan qué variable aplica a cuál.
# ─────────────────────────────────────────────────────────────────

# ─── Base de datos ───────────────────────────────────────────────
# [Nativo] Apunta a tu PostgreSQL local (puerto 5432 por defecto).
# [Docker stack completo] La app se conecta al servicio `postgres`
#   internamente; este DATABASE_URL se IGNORA en `docker-compose.yml`
#   (allí se arma desde POSTGRES_USER/PASSWORD/DB).
DATABASE_URL="postgresql://siib:siib_dev@localhost:5432/siib?schema=public"

# [Docker] Credenciales que crea el contenedor de PostgreSQL.
POSTGRES_USER=siib
POSTGRES_PASSWORD=siib_dev
POSTGRES_DB=siib

# ─── Auth.js (NextAuth v5) ───────────────────────────────────────
# Genera con:   openssl rand -base64 32
# Es OBLIGATORIO en producción y en modo Docker (compose la valida).
AUTH_SECRET="cambia-este-valor-en-produccion-32-chars-min"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# ─── Almacenamiento de PDFs ─────────────────────────────────────
# [Nativo] Ruta relativa al proyecto.
# [Docker] Dentro del contenedor siempre es /app/storage/uploads
#   (se monta como volumen `siib_uploads`).
STORAGE_LOCAL_PATH="./storage/uploads"
STORAGE_MAX_FILE_SIZE_MB=20

# ─── Job de alertas ──────────────────────────────────────────────
# Protege el endpoint POST /api/alerts/scan
ALERTS_SCAN_TOKEN="cambia-este-token-largo-y-aleatorio"

# ─── Comportamiento del contenedor `app` ─────────────────────────
# Si es true, el contenedor ejecuta `npm run db:seed` al arrancar.
# El seed es idempotente (usa upsert), pero deshazlo después de la
# primera vez si no quieres recrear los usuarios demo.
SEED_ON_BOOT=true

# Puerto público del host (Docker). Cambia si 3000 está ocupado.
APP_PORT=3000

# ─── Entorno ────────────────────────────────────────────────────
NODE_ENV=development
